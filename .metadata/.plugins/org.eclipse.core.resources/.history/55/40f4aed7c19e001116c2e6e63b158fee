package com.shriti.basics;

public class IncDecrementOperators {
	
	public static void main(String[] args) {
		
		int num1=100;
		int num2=200;
		
		int num3=num1++ + num2++;//300
		System.out.println(num3+" "+num1+" "+num2);//300 101 201
		
		int num4=--num1+--num3;
		System.out.println(num4+""+num1+" "+num3);//399 100 299
		
		int marks=95;
		//ternary operator
	   String gradeInfo= (marks>90)?"You got a A++ Grade":"You got a B Grade";
	   
	   System.out.println(gradeInfo);
	   
	}

}
