package com.shriti.controlflow;

public class SwitchDemo {
	
	public static void main(String[] args) {
		
		//calculator
		//input two numbers and an operator(+,-,*,/)->perform the operation
		int num1=10;
		int num2=20;
		String operator="*";
		
		switch (operator) {
		case "+":
			System.out.println("sum = "+(num1+num2));
			break;
		case "-":
			System.out.println("difference = "+(num1-num2));
			break;
		case "*":
			System.out.println("product = "+(num1*num2));
			break;
		case "/":
			System.out.println("divison  = "+(num1/num2));
			break;
			
		default:
			System.out.println(" operator is not match");
		}
		System.out.println("=======================================================");
		//check days -workday/weekoff as o/p
		String day="monday";
		
		switch(day.toUpperCase()) {
		case "MONDAY":
			System.out.println(" starting day of week and get to work!!");
			break;
		case "TUESDAY":
		case "WEDNESDAY":
		case "THURSDAY":
			System.out.println(" busy in work!!");
			break;
		case"FRIDAY":
			System.out.println(" Weekend mode started!!");
			break;
		case"SATURDAY":
		case"SUNDAY":
			System.out.println(" weekend started and enjoy !!");
			break;
			default:
				System.out.println("Invalid day");
		}
	}

}
