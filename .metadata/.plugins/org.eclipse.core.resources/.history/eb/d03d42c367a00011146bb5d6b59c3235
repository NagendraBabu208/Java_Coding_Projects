package com.basics.quest2;

import java.util.Scanner;

public class BankMain {

	public static void main(String[] args) {

		Bank bank=new Bank(5000);
		Scanner scanner= new Scanner(System.in);
		boolean isATMAvailable=true;
		while(isATMAvailable) {
			
			System.out.println(" please select operations like withdraw/deposit/balance/exit");
			String userInput=scanner.nextLine().toUpperCase();

			switch(userInput) {

			case "WITHDRAW":
				System.out.println(" enter the withdraw Amount:: ");
				double amount=scanner.nextDouble();
				scanner.nextLine();//consume next line
				bank.withdrawAmount(amount);
				break;
			case "DEPOSIT":
				System.out.println(" enter the deposit Amount:: ");
				double depositAmount=scanner.nextDouble();
				scanner.nextLine();//consume next line
				bank.depositeAmount(depositAmount);
				break;
			case "BALANCE":
				double balance=bank.getBalancce();
				System.out.println("Available balance of in your Account is:: "+balance);
				break;
			case "EXIT":
				System.out.println("Thanks for using ATM. See you again!!!");
				scanner.close();
				return;
			default:
				System.out.println(" Invalid user input:: ");

			}
		}
	}
}
